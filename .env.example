# Django Core Settings
SECRET_KEY=django-insecure-devconnect-api-super-secret-key-prod-ready-jwt-auth
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL / Production; defaults to SQLite for local development if empty)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=devconnect_db
DB_USER=devconnect_user
DB_PASSWORD=devconnect_password
DB_HOST=localhost
DB_PORT=5432

# SimpleJWT Settings
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7