  "item": [
    {
      "name": "01. Authentication & JWT Session",
      "item": [
        {
          "name": "Register Developer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var timestamp = Date.now();",
                  "pm.environment.set('dynamicUsername', 'dev_' + timestamp);",
                  "pm.environment.set('dynamicEmail', 'dev_' + timestamp + '@devconnect.io');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('JWT tokens received', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.tokens).to.have.property('access');",
                  "    pm.expect(json.tokens).to.have.property('refresh');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{dynamicUsername}}\",\n  \"email\": \"{{dynamicEmail}}\",\n  \"password\": \"StrongPassword123!\",\n  \"password_confirm\": \"StrongPassword123!\",\n  \"role\": \"DEVELOPER\",\n  \"headline\": \"Full Stack Engineer\",\n  \"location\": \"San Francisco, CA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                ""
              ]
            }
          }
        },
        {
          "name": "Login (Obtain JWT Pair)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Contains access and refresh tokens', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('access');",
                  "    pm.expect(json).to.have.property('refresh');",
                  "    pm.expect(json.user.role).to.eql('DEVELOPER');",
                  "    pm.environment.set('token', json.access);",
                  "    pm.environment.set('refreshToken', json.refresh);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"parth@devconnect.io\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            }
          }
        },
        {
          "name": "Refresh JWT Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('New access token generated', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('access');",
                  "    pm.environment.set('token', json.access);",
                  "    if (json.refresh) { pm.environment.set('refreshToken', json.refresh); }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/token/refresh/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token",
                "refresh",
                ""
              ]
            }
          }
        }
      ]
    },
